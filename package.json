{
  "name": "wec-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo design system internal wec-ui — Web Components (Lit) untuk Angular, React, Next.js, dan Drupal.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter wec-ui storybook",
    "build": "pnpm build:tokens && pnpm build:icons && pnpm --filter wec-ui build",
    "build:tokens": "node tokens/build.mjs",
    "build:icons": "node tools/icons/generate.mjs",
    "build:storybook": "pnpm --filter wec-ui build:storybook",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --filter wec-ui typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "eslint-plugin-lit": "^2.3.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "prettier --write"
    ]
  }
}
