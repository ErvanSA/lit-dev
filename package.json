{
  "name": "wec-ui-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Monorepo design system internal wec-ui — Web Components (Lit) untuk Angular, React, Next.js, dan Drupal.",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm --filter wec-ui storybook",
    "build": "pnpm build:tokens && pnpm build:icons && pnpm --filter wec-ui build && pnpm gen:wrappers && pnpm --filter @wec-ui/react build",
    "build:tokens": "node tokens/build.mjs",
    "build:icons": "node tools/icons/generate.mjs",
    "gen:wrappers": "node tools/generate-wrappers/generate.mjs",
    "build:react-smoke": "esbuild packages/react/tests/e2e/manual.tsx --bundle --format=esm --jsx=automatic --outfile=packages/core/tests/e2e/fixtures/react-bundle.js",
    "build:storybook": "pnpm --filter wec-ui build:storybook",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "pnpm build:react-smoke && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "changeset": "changeset",
    "version:pkg": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0",
    "@playwright/test": "^1.64.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-lit": "^2.3.1",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "style-dictionary": "^4.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yaml,yml}": [
      "prettier --write"
    ]
  }
}
