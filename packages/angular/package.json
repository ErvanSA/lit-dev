{
  "name": "@wec-ui/angular",
  "version": "0.3.0",
  "description": "Wrapper Angular untuk design system wec-ui — digenerate dari Custom Elements Manifest.",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "wec-ui": "workspace:*"
  },
  "peerDependencies": {
    "@angular/core": "^18.0.0 || ^19.0.0 || ^20.0.0"
  },
  "devDependencies": {
    "@angular/core": "^18.2.14",
    "rxjs": "^7.8.2"
  }
}
